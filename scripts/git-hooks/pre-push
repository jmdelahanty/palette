#!/usr/bin/env bash
# Refuse a push whose checked-in Zarr census is stale (CI's "generated
# artifacts" gate), so it is caught in ~25 s locally instead of failing CI and
# skipping every test shard.
#
# Enable once per clone. Use the RELATIVE path so each worktree runs the hook
# from its own checkout (an absolute path pins every worktree to whatever
# branch that one checkout has, which may predate this file):
#   git config core.hooksPath scripts/git-hooks
# Bypass for one push: PALETTE_SKIP_PRE_PUSH=1 git push ...
#
# The census reads only src/**/*.py and scripts/**/*.py and writes five
# docs/diagnostics/zarr_* files. The check runs on the pushed commit itself
# (extracted with git archive), never on the working tree, and only when the
# push changes those paths relative to its merge base with origin/main.
# Branch deletions are ignored.
#
# When the census is stale the hook regenerates it for the pushed commit. If
# the pushed commit is the checked-out HEAD, the regenerated files are copied
# into the working tree; commit them and push again. The hook never commits.
set -uo pipefail
[ "${PALETTE_SKIP_PRE_PUSH:-}" = 1 ] && exit 0

root=$(git rev-parse --show-toplevel)
head_sha=$(git rev-parse --verify -q HEAD || true)
census=fisheye.diagnostics.zarr_storage_census
inputs=(':(glob)src/**/*.py' ':(glob)scripts/**/*.py' ':(glob)docs/diagnostics/zarr_*')
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue  # branch deletion
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  if [ -n "$base" ] && git diff --quiet "$base" "$local_sha" -- "${inputs[@]}"; then
    continue  # no census input or output changed on this branch
  fi

  tree=$(mktemp -d)
  git archive "$local_sha" src scripts docs/diagnostics | tar -x -C "$tree"
  if PYTHONPATH="$tree/src" "$root/scripts/py" -m "$census" \
      --repo-root "$tree" --check </dev/null; then
    rm -rf "$tree"
    continue
  fi

  status=1
  cp -R "$tree/docs/diagnostics" "$tree/.diagnostics_before"
  if PYTHONPATH="$tree/src" "$root/scripts/py" -m "$census" \
      --repo-root "$tree" --write </dev/null >/dev/null; then
    regenerated=()
    for f in "$tree"/docs/diagnostics/zarr_*; do
      name=${f##*/}
      cmp -s "$f" "$tree/.diagnostics_before/$name" || regenerated+=("docs/diagnostics/$name")
    done
    if [ "$local_sha" = "$head_sha" ]; then
      for rel in "${regenerated[@]}"; do
        cp "$tree/$rel" "$root/$rel"
      done
      echo "pre-push: Zarr census was stale for $local_ref; regenerated:" >&2
      printf '  %s\n' "${regenerated[@]}" >&2
      echo "Commit these files and push again." >&2
    else
      echo "pre-push: Zarr census is stale for $local_ref (not the checked-out HEAD," >&2
      echo "so the working tree was left alone). Check it out, then run" >&2
      echo "  scripts/py -m $census --write" >&2
      echo "commit docs/diagnostics/zarr_* and push again." >&2
    fi
  else
    echo "pre-push: Zarr census is stale for $local_ref and regeneration failed. Run" >&2
    echo "  scripts/py -m $census --write" >&2
    echo "commit docs/diagnostics/zarr_* and push again." >&2
  fi
  rm -rf "$tree"
done
exit $status
