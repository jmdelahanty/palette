#!/usr/bin/env bash
set -euo pipefail

palette_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
palette_repo_root="$(cd "$palette_script_dir/.." && pwd)"
case ":${PYTHONPATH:-}:" in
  *":$palette_repo_root/src:"*) ;;
  *) export PYTHONPATH="$palette_repo_root/src${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

run_python() {
  local python_bin="$1"
  shift

  local env_prefix
  local env_lib
  env_prefix="$(cd "$(dirname "$python_bin")/.." && pwd)"
  env_lib="$env_prefix/lib"
  if [[ -d "$env_lib" ]]; then
    case ":${LD_LIBRARY_PATH:-}:" in
      *":$env_lib:"*) ;;
      *) export LD_LIBRARY_PATH="$env_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
  fi

  exec "$python_bin" "$@"
}

if [[ -n "${PALETTE_PYTHON:-}" ]]; then
  run_python "$PALETTE_PYTHON" "$@"
fi

python_candidates=(
  "$HOME/miniconda3/envs/palette-py311/bin/python"
  "$HOME/miniforge3/envs/palette-py311/bin/python"
)

palette_account_home=""
if command -v getent >/dev/null 2>&1; then
  palette_account_name="$(id -un)"
  palette_passwd_entry="$(getent passwd "$palette_account_name" || true)"
  if [[ -n "$palette_passwd_entry" ]]; then
    IFS=: read -r _ _ _ _ _ palette_account_home _ <<< "$palette_passwd_entry"
  fi
fi
if [[ -n "$palette_account_home" && "$palette_account_home" != "$HOME" ]]; then
  python_candidates+=(
    "$palette_account_home/miniconda3/envs/palette-py311/bin/python"
    "$palette_account_home/miniforge3/envs/palette-py311/bin/python"
  )
fi

for candidate in "${python_candidates[@]}"; do
  if [[ -x "$candidate" ]]; then
    run_python "$candidate" "$@"
  fi
done

echo "Could not find palette-py311 Python under \$HOME or the account home." >&2
echo "Set PALETTE_PYTHON=/path/to/python or create the palette-py311 env." >&2
exit 127
