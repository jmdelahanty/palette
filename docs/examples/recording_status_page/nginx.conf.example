# Example nginx server block for exposing the recording status page with auth/TLS.
#
# Adjust:
# - server_name
# - certificate paths
# - htpasswd path
#
# Keep the Python app bound to:
#   127.0.0.1:8765

server {
    listen 443 ssl http2;
    server_name status.palette.example.org;

    ssl_certificate     /etc/ssl/certs/status.palette.example.org.pem;
    ssl_certificate_key /etc/ssl/private/status.palette.example.org.key;

    auth_basic           "Recording Status Page";
    auth_basic_user_file /etc/nginx/.htpasswd-status-page;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Optional redirect:
server {
    listen 80;
    server_name status.palette.example.org;
    return 301 https://$host$request_uri;
}
