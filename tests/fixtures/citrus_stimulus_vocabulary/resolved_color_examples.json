    {
      "name": "decimal-vs-binary32 trap: 0.3 and 0.7",
      "authored": [
        0.3,
        0.7,
        0.3,
        1.0
      ],
      "brightness": 1.0,
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          77,
          178,
          77,
          255
        ]
      },
      "note": "binary32 nearest 0.3 is 0.300000012 (76.500003 -> 77); binary32 nearest 0.7 is 0.699999988 (178.499997 -> 178). Quantising the doubles gives 77 and 179 (lround) or 76 and 178 (Python round); both fail this fixture."
    },
    {
      "name": "binary32 nearest 0.9 rounds down",
      "authored": [
        0.9,
        0.9,
        0.9,
        1.0
      ],
      "brightness": 1.0,
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          229,
          229,
          229,
          255
        ]
      },
      "color_name": "gray",
      "note": "0.9 as binary32 is 0.899999976; 229.499994 -> 230 under a float32 multiply-add (the pre-#28 device kernel), 229 under the rule. A double 0.9 would also give 230."
    },
    {
      "name": "device path (chaser appearance realized colour) uses the same rule",
      "authored": [
        0.7,
        0.9,
        0.3,
        1.0
      ],
      "brightness": 1.0,
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          178,
          229,
          77,
          255
        ]
      },
      "note": "object_appearance_contrast.cuh QuantizeCodeValueToU8V1 as of citrus #28 (b470de2); its float32 predecessor gave [179, 230, 77, 255]. Citrus replays this row on the GPU in tests/test_object_appearance_contrast_device.cu; Palette replays it with its host quantiser."
    },
    {
      "name": "plain_v1: grating line at brightness 0.5",
      "authored": [
        1.0,
        0.5,
        0.7,
        1.0
      ],
      "brightness": 0.5,
      "derivation": "plain_v1",
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          128,
          64,
          89,
          255
        ]
      },
      "note": "binary32(0.7 * 0.5) = 0.349999994 -> 89.2499985 -> 89; alpha is not scaled by brightness."
    },
    {
      "name": "opaque_alpha_v1: spotlight spot",
      "authored": [
        1.0,
        1.0,
        0.0,
        0.5
      ],
      "brightness": 1.0,
      "derivation": "opaque_alpha_v1",
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          255,
          255,
          0,
          255
        ]
      },
      "note": "flash and spotlight display opaque; the authored alpha is recorded but not displayed."
    },
    {
      "name": "premultiplied_background_v1: concentric-dots background",
      "authored": [
        0.4,
        0.2,
        0.0,
        0.25
      ],
      "brightness": 1.0,
      "derivation": "premultiplied_background_v1",
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          26,
          13,
          0,
          255
        ]
      },
      "note": "binary32(0.4 * 0.25) = 0.100000001 -> 25.5000004 -> 26; binary32(0.2 * 0.25) = 0.0500000007 -> 12.75 -> 13; alpha 255. The pre-#29 kernel truncated the code (25, 12)."
    },
    {
      "name": "edge_minimum_floor_half_v1: chaser background 0.5 at minimum_brightness 0.25",
      "authored": [
        0.5,
        0.5,
        0.5,
        1.0
      ],
      "brightness": 0.25,
      "derivation": "edge_minimum_floor_half_v1",
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          32,
          32,
          32,
          255
        ]
      },
      "note": "code = V1(0.5) = 128; floor(128 * 0.25 + 0.5) = 32 (exact in double); alpha keeps the code 255."
    },
    {
      "name": "edge_minimum_floor_half_v1: white background at minimum_brightness 0.25",
      "authored": [
        1.0,
        1.0,
        1.0,
        1.0
      ],
      "brightness": 0.25,
      "derivation": "edge_minimum_floor_half_v1",
      "recorded": {
        "color_space": "srgb",
        "rgba8": [
          64,
          64,
          64,
          255
        ]
      },
      "note": "floor(255 * 0.25 + 0.5) = floor(64.25) = 64."
    }
  ],
  "h5_per_frame_column_examples": [
    {
      "name": "visual_appearance stored float32(k/255) -> k",
      "stored_codes": [
        1,
        127,
        128,
        254
      ],
      "recovered": [
        1,
        127,
        128,
        254
      ],
      "note": "stored = float32(k/255); V1(stored) = k for every k in 0..255; float32(k/255)*255 is not an integer in double for 254 of them (only 0 and 255)."
    },
    {
      "name": "moving_grating stored line float -> displayed code (v3-with-elements files only)",
