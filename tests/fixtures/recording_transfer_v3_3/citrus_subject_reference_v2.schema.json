{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citrus.subject_reference.v2",
  "title": "Citrus subject reference v2 (finalized receipt v4 contract.subject_reference)",
  "description": "The MetaZebrobot-confirmed subject record Citrus wrote to /metadata/subject, carried in citrus.recording_observation_finalized_receipt v4 as contract.subject_reference. Authoritative for Orange's recording_session.json subject_references[camera_id]. v2 (subject identity v4): subject_id is the MetaZebrobot fish UUID for an individual and null for a dish_group. See citrus-palette/subject_identity_v4_2026-10-14.md.",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "dish_id",
    "lookup_status",
    "lookup_reason",
    "lookup_http_status",
    "queried_at_utc",
    "dish",
    "fish_status",
    "fish_reason",
    "fish",
    "subject_id",
    "subject_type",
    "subject_count",
    "zebrobot_version",
    "source"
  ],
  "properties": {
    "schema_id": {
      "const": "citrus.subject_reference"
    },
    "schema_version": {
      "const": 2
    },
    "dish_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "lookup_status": {
      "enum": [
        "collected",
        "not_collected"
      ]
    },
    "lookup_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "lookup_http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP status of the dish lookup when it failed with an HTTP response; null when collected or when there was no HTTP response (transport failure)."
    },
    "queried_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "dish": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "dish_id",
        "dish_uuid",
        "dish_revision",
        "dish_updated_at",
        "fish_count",
        "cross_id"
      ],
      "properties": {
        "dish_id": {
          "type": "string",
          "minLength": 1
        },
        "dish_uuid": {
          "$ref": "#/$defs/uuid"
        },
        "dish_revision": {
          "type": "integer",
          "minimum": 0
        },
        "dish_updated_at": {
          "type": "string",
          "minLength": 1
        },
        "fish_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "fish_status": {
      "enum": [
        "collected",
        "not_collected"
      ]
    },
    "fish_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "fish": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "fish_id",
        "revision",
        "updated_at"
      ],
      "properties": {
        "fish_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "subject_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/uuid"
        }
      ]
    },
    "subject_type": {
      "enum": [
        "individual",
        "dish_group",
        null
      ]
    },
    "subject_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "zebrobot_version": {
      "type": [
        "object",
        "null"
      ],
      "description": "MZB GET /version as Citrus read it once per session before the dish lookup; null when /version was unreachable. Same field names and patterns as Orange recording_subject_reference v2 zebrobot.*, so Palette's MZB pin check applies to citrus_binding entries unchanged.",
      "required": [
        "base_url",
        "api_schema_version",
        "service_commit",
        "service_commit_dirty",
        "consumer_schema_sha256",
        "http_status",
        "error"
      ],
      "properties": {
        "base_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "api_schema_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "service_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "service_commit_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "consumer_schema_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "const": "citrus_mzb_lookup"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lookup_status": {
            "const": "collected"
          }
        }
      },
      "then": {
        "properties": {
          "dish": {
            "type": "object"
          },
          "lookup_reason": {
            "type": "null"
          },
          "lookup_http_status": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "dish": {
            "type": "null"
          },
          "lookup_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fish_status": {
            "const": "collected"
          }
        }
      },
      "then": {
        "properties": {
          "fish": {
            "type": "object"
          },
          "fish_reason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "fish": {
            "type": "null"
          },
          "fish_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dish_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "subject_id": {
            "type": "null"
          },
          "subject_type": {
            "type": "null"
          },
          "subject_count": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "subject_type": {
            "type": "string"
          },
          "subject_count": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "individual"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "$ref": "#/$defs/uuid"
          },
          "subject_count": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "dish_group"
          }
        },
        "required": [
          "subject_type"
        ]
      },
      "then": {
        "properties": {
          "subject_id": {
            "type": "null"
          },
          "subject_count": {
            "type": "integer",
            "minimum": 2
          },
          "fish_status": {
            "const": "not_collected"
          },
          "fish": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
