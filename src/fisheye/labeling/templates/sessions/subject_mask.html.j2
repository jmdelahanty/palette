<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@@safe_title@@</title>
  <link rel="stylesheet" href="@@palette_css@@">
  <link rel="stylesheet" href="@@editor_css@@">
  <style>
    :root { --bad: var(--danger); --muted: var(--ink-2); }
    @@session_operator_support_css@@
  </style>
</head>
<body class="editor">
  <header class="editor-top">
    <nav class="editor-return" aria-label="Return">@@return_links@@</nav>
    <div class="editor-title">
      <h1>@@safe_title@@</h1>
      <span>Scoped subject-mask session <code>@@session_id@@</code></span>
    </div>
  </header>

  <div class="editor-body">
    <div id="canvas-stage" class="editor-stage">
      <canvas id="canvas"></canvas>
      <div class="stage-hint">Scroll to zoom · middle-drag to pan</div>
    </div>

    <aside class="editor-side" aria-label="Mask tools">
      @@session_operator_support_html@@

      <section class="side-section" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Tools</h2>
        <div class="side-grid">
          <button id="paint-button" type="button" class="btn tool active" onclick="setTool('paint')">Paint <kbd>B</kbd></button>
          <button id="erase-button" type="button" class="btn tool" onclick="setTool('erase')">Erase <kbd>E</kbd></button>
          <button id="lasso-button" type="button" class="btn tool" onclick="toggleLassoMode()">Lasso <kbd>V</kbd></button>
          <button id="fill-holes-button" type="button" class="btn tool" onclick="setTool('fill')">Fill holes <kbd>H</kbd></button>
        </div>
        <label for="brush-size">Brush size <span><span id="brush-label">8</span> px <kbd>[</kbd> <kbd>]</kbd></span></label>
        <input id="brush-size" type="range" min="1" max="48" value="8" oninput="setBrushSize(Number(this.value));">
        <button id="copy-previous-button" type="button" class="btn" data-key="C" onclick="copyPreviousMask()" disabled>Copy previous mask</button>
        <button id="undo-bulk-button" type="button" class="btn" onclick="undoBulkEdit()" disabled>Undo</button>
      </section>

      <section class="side-section" aria-labelledby="check-heading">
        <h2 id="check-heading">Mask check</h2>
        <p id="mask-pieces" class="mask-check" aria-live="polite"></p>
        <button id="remove-stray-button" type="button" class="btn" onclick="removeStrayPiecesAction()" disabled>Remove stray pieces <kbd>R</kbd></button>
      </section>

      <section class="side-section" aria-labelledby="lasso-heading">
        <h2 id="lasso-heading">Lasso</h2>
        <div class="side-grid">
          <button type="button" class="btn" onclick="fillLasso(false, null)">Fill inside <kbd>F</kbd></button>
          <button type="button" class="btn" onclick="fillLasso(true, null)">Fill outside <kbd>G</kbd></button>
          <button type="button" class="btn" onclick="fillLasso(true, 0)">Erase outside <kbd>E</kbd></button>
          <button type="button" class="btn" onclick="undoLassoPoint()">Undo point <kbd>U</kbd></button>
          <button type="button" class="btn" onclick="clearLasso()">Clear lasso <kbd>D</kbd></button>
        </div>
      </section>

      <section id="tail-border-controls" class="side-section" hidden aria-label="Visible tail endpoint acceptance">
        <h2>Tail reaches crop edge</h2>
        <p class="meta">Accept only when the slightly clipped tail is usable. The last derived point represents the visible endpoint at the crop edge; it does not reconstruct the missing anatomical tip. Checkpoint this decision, then use Apply saved edits to regenerate the tail. This does not approve the mask or training labels.</p>
        <label for="tail-border-preset">Reason for accepting this ROI</label>
        <select id="tail-border-preset" onchange="updateTailBorderReasonInput()">
          <option value="slight-tip">Only the tiny tail tip is clipped; visible tail is usable.</option>
          <option value="custom">Write a custom reason</option>
        </select>
        <label id="tail-border-reason-label" for="tail-border-reason">Optional notes</label>
        <input id="tail-border-reason" type="text" maxlength="240" placeholder="Optional details for this ROI">
        <div class="side-grid">
          <button type="button" class="btn" onclick="saveTailBorder('accept')">Checkpoint acceptance</button>
          <button type="button" class="btn" onclick="saveTailBorder('revoke')">Checkpoint revocation</button>
        </div>
        <div id="tail-border-status" class="meta"></div>
      </section>

      <section class="side-section" aria-labelledby="review-heading">
        <h2 id="review-heading">Row review</h2>
        <p id="review-current" class="meta"></p>
        <label for="review-state">Component review state</label>
        <div class="side-row">
          <select id="review-state" onchange="reviewSelectChanged()">
            <option value="approved">approved</option>
            <option value="pending">pending</option>
            <option value="needs_review">needs_review</option>
            <option value="rejected">rejected</option>
          </select>
          <button id="set-review-button" type="button" class="btn btn-outline" onclick="setReviewStatus()">Set review</button>
        </div>
      </section>

      <section class="side-section" aria-labelledby="view-heading">
        <h2 id="view-heading">View</h2>
        <select id="mask-view" onchange="setMaskView(this.value)" aria-describedby="mask-view-help">
          <option value="overlay">Image + mask</option>
          <option value="binary">Binary mask</option>
        </select>
        <p id="mask-view-help" class="meta">Binary view shows the selected label in white and background in black. Paint, erase, and lasso work in either view.</p>
      </section>

      <section class="side-section" aria-labelledby="row-heading">
        <h2 id="row-heading">This row</h2>
        <div id="summary" class="meta"></div>
        <label for="roi-seek-input">Go to ROI</label>
        <div class="side-row">
          <input id="roi-seek-input" type="number" min="0" step="1" placeholder="ROI #" onkeydown="if (event.key === 'Enter') seekRoi();">
          <button type="button" class="btn" onclick="seekRoi()">Go</button>
        </div>
        <div class="side-grid">
          <button type="button" class="btn" onclick="loadCurrent()">Reload ROI</button>
          <button type="button" class="btn btn-danger" onclick="clearMask()">Clear local</button>
        </div>
      </section>

      <details class="side-section">
        <summary class="side-heading">Keyboard shortcuts</summary>
        <p class="meta">Wheel zooms, middle-drag pans. <kbd>S</kbd> save, <kbd>⇧ S</kbd> save + next, <kbd>N</kbd>/<kbd>P</kbd> navigate, <kbd>B</kbd>/<kbd>E</kbd> paint/erase, <kbd>X</kbd> toggles brush mode, <kbd>[</kbd>/<kbd>]</kbd> brush size, <kbd>V</kbd> lasso; in lasso <kbd>F</kbd> fills inside, <kbd>G</kbd> fills outside, <kbd>E</kbd> erases outside, <kbd>U</kbd> undoes a point, <kbd>D</kbd> clears the contour. <kbd>H</kbd> fill holes (click a piece), <kbd>R</kbd> removes stray pieces, <kbd>C</kbd> copies the previous row's mask (same crop position), <kbd>Ctrl Z</kbd> undoes the last fill, removal or copy.</p>
      </details>

      <details class="side-section">
        <summary class="side-heading">Session</summary>
        @@status_banner@@
      </details>
    </aside>
  </div>

  <footer class="editor-actions">
    <button id="nav-prev-button" type="button" class="btn" onclick="nav(-1)">‹ Prev <kbd>P</kbd></button>
    <button type="button" class="btn btn-outline" onclick="save(false)">Save <kbd>S</kbd></button>
    <button type="button" class="btn btn-primary" onclick="save(true)">Save + Next <kbd>⇧ S</kbd></button>
    <button id="nav-next-button" type="button" class="btn" onclick="nav(1)">Next › <kbd>N</kbd></button>
    <div class="status-area">
      <p id="status" class="status" role="status">Loading ROI...</p>
      <button id="copy-mutation-support-reference" type="button" class="btn" hidden onclick="copyMutationSupportReference(this)">Copy support reference</button>
    </div>
    <button type="button" class="btn btn-primary" onclick="applySavedEdits()">Apply saved rows</button>
    <button type="button" class="btn" onclick="completeTask()">Complete task</button>
  </footer>

  <script>
  window.PALETTE_SUBJECT_MASK_SESSION_ID = @@session_id_json@@;
</script>
<script src="@@canvas_stage_fit_js@@"></script>
<script>
@@operator_support_js@@
</script>
<script>
@@browser_mutation_status_js@@
</script>
<script>
@@image_canvas_viewport_js@@
</script>
<script>
@@subject_mask_editor_js@@
</script>
<script>
  fitCanvasToStage(document.getElementById("canvas"), document.getElementById("canvas-stage"));
</script>
</body>
</html>
