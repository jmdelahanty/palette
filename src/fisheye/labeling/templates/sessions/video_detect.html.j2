<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@@safe_title@@</title>
  <link rel="stylesheet" href="@@palette_css@@">
  <link rel="stylesheet" href="@@editor_css@@">
  <style>
    :root { --bad: var(--danger); --muted: var(--ink-2); }
    @@session_operator_support_css@@
  </style>
</head>
<body class="editor">
  <header class="editor-top">
    <nav class="editor-return" aria-label="Return">@@return_links@@</nav>
    <div class="editor-title">
      <h1>@@safe_title@@</h1>
      <span>Scoped video detection session <code>@@session_id@@</code></span>
    </div>
  </header>

  <div class="editor-body">
    <div id="video-stage" class="editor-stage">
      <div class="canvas-frame">
        <video id="video" muted playsinline controls preload="metadata"></video>
        <canvas id="overlay" class="video-draw-layer"></canvas>
      </div>
      <div class="stage-hint top">Drag on the video to draw or replace the box</div>
    </div>

    <aside class="editor-side" aria-label="Video detection tools">
      @@session_operator_support_html@@

      <section class="side-section" aria-labelledby="frame-heading">
        <h2 id="frame-heading">This frame</h2>
        <div id="summary" class="meta"></div>
        <button id="clear-button" type="button" class="btn btn-danger" onclick="clearBox()">Clear local</button>
        <p class="meta">This workflow is read-only unless the task scope has <code>editable=true</code>.</p>
      </section>

      <details class="side-section">
        <summary class="side-heading">Keyboard shortcuts</summary>
        <p class="meta"><kbd>S</kbd> saves, <kbd>N</kbd>/<kbd>P</kbd> navigate.</p>
      </details>

      <details class="side-section">
        <summary class="side-heading">Session</summary>
        @@status_banner@@
      </details>
    </aside>
  </div>

  <footer class="editor-actions">
    <button type="button" class="btn" data-key="P" onclick="nav(-1)">‹ Prev</button>
    <button id="save-button" type="button" class="btn btn-outline" data-key="S" onclick="save(false)">Save box</button>
    <button id="save-next-button" type="button" class="btn btn-primary" onclick="save(true)">Save + Next</button>
    <button type="button" class="btn" data-key="N" onclick="nav(1)">Next ›</button>
    <div class="status-area">
      <p id="status" class="status" role="status">Loading frame...</p>
      <button id="copy-mutation-support-reference" type="button" class="btn" hidden onclick="copyMutationSupportReference(this)">Copy support reference</button>
    </div>
    <button type="button" class="btn" onclick="completeTask()">Complete task</button>
  </footer>

  <script>
  window.PALETTE_VIDEO_DETECT_SESSION_ID = @@session_id_json@@;
</script>
<script src="@@canvas_stage_fit_js@@"></script>
<script>
@@operator_support_js@@
</script>
<script>
@@browser_mutation_status_js@@
</script>
<script>
@@video_detect_editor_js@@
</script>
<script>
  fitCanvasToStage(document.getElementById("video"), document.getElementById("video-stage"));
</script>
</body>
</html>
