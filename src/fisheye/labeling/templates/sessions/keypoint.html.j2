<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@@safe_title@@</title>
  <link rel="stylesheet" href="@@palette_css@@">
  <link rel="stylesheet" href="@@editor_css@@">
  <style>
    :root { --bad: var(--danger); --muted: var(--ink-2); }
    @@session_operator_support_css@@
  </style>
</head>
<body class="editor">
  <header class="editor-top">
    <nav class="editor-return" aria-label="Return">@@return_links@@</nav>
    <div class="editor-title">
      <h1>@@safe_title@@</h1>
      <span>Scoped keypoint session <code>@@session_id@@</code></span>
    </div>
  </header>

  <div class="editor-body">
    <div id="canvas-stage" class="editor-stage">
      <div class="canvas-frame">
        <canvas id="canvas"></canvas>
        <canvas id="keypoint-overlay" class="canvas-overlay" aria-hidden="true"></canvas>
      </div>
      <div class="stage-hint top">Scroll to zoom · middle-drag to pan · click to place the selected point</div>
      <div id="keypoint-legend" class="stage-legend" aria-label="Keypoint colours"></div>
    </div>

    <aside class="editor-side" aria-label="Keypoint tools">
      @@session_operator_support_html@@

      <section class="side-section" aria-labelledby="landmarks-heading">
        <div class="side-row" style="justify-content: space-between">
          <h2 id="landmarks-heading" style="flex-grow: 0">Landmarks</h2>
          <span id="points-placed" class="meta" style="flex-grow: 0"></span>
        </div>
        <div id="points"></div>
      </section>

      <section class="side-section" aria-labelledby="row-heading">
        <h2 id="row-heading">This row</h2>
        <div class="side-grid">
          <button id="no-keypoints-button" type="button" class="btn" data-key="X" onclick="action('mark_no_keypoints')">No keypoints</button>
          <button id="detection-issue-button" type="button" class="btn" onclick="action('mark_detection_issue')">Detection issue</button>
        </div>
        <div id="summary" class="meta"></div>
      </section>

      <section class="side-section" aria-labelledby="saving-heading">
        <h2 id="saving-heading">Saving</h2>
        <p id="checkpoint-status" class="meta" hidden></p>
        <p id="apply-help" class="meta">Apply writes the saved snapshot under the exclusive canonical writer. You can keep reviewing other rows while it runs.</p>
        <p id="immutable-direct-save-note" class="meta" hidden>
          Direct delta mode: Save writes this row directly to the task-bound immutable delta. There is no separate Apply step and the immutable base is not changed.
        </p>
      </section>

      <section class="side-section" aria-labelledby="review-heading">
        <h2 id="review-heading">Row review</h2>
        <div id="mutable-review-controls">
          <p id="review-current" class="meta"></p>
          <label for="review-state">Review state</label>
          <div class="side-row">
            <select id="review-state" onchange="reviewSelectChanged()">
              <option value="approved">approved</option>
              <option value="pending">pending</option>
              <option value="needs_review">needs_review</option>
              <option value="rejected">rejected</option>
            </select>
            <button id="set-review-button" type="button" class="btn btn-outline" onclick="setReviewStatus()">Set review</button>
          </div>
        </div>
        <p id="immutable-delta-review-note" class="meta" hidden>
          Edits are being recorded in a task-bound delta generation. Complete the task when review is finished; an operator will freeze, validate, and compact those edits into a new immutable candidate before approval.
        </p>
      </section>

      <details class="side-section">
        <summary class="side-heading">Keyboard shortcuts</summary>
        <p class="meta">Wheel zooms, middle-drag pans, <kbd>F</kbd> fits. <kbd>N</kbd>/<kbd>P</kbd> move ROI, <kbd>S</kbd> saves, <kbd>⇧ S</kbd> saves + next, <kbd>T</kbd> toggles text, <kbd>[</kbd>/<kbd>]</kbd> cycle points, <kbd>1</kbd>–<kbd>9</kbd> select keypoints 1–9, <kbd>0</kbd> selects keypoint 10, <kbd>R</kbd> resets, <kbd>X</kbd> marks no keypoints.</p>
      </details>

      <details class="side-section">
        <summary class="side-heading">Session</summary>
        @@status_banner@@
      </details>
    </aside>
  </div>

  <footer class="editor-actions">
    <button id="nav-prev-button" type="button" class="btn" data-key="P" onclick="nav(-1)">‹ Prev</button>
    <button id="save-button" type="button" class="btn btn-outline" data-key="S" onclick="save(false)">Save</button>
    <button id="save-next-button" type="button" class="btn btn-primary" data-key="⇧ S" onclick="save(true)">Save + Next</button>
    <button id="nav-next-button" type="button" class="btn" data-key="N" onclick="nav(1)">Next ›</button>
    <div class="status-area">
      <p id="status" class="status" role="status">Loading ROI...</p>
      <button id="copy-mutation-support-reference" type="button" class="btn" hidden onclick="copyMutationSupportReference(this)">Copy support reference</button>
    </div>
    <div id="apply-controls" hidden>
      <button id="apply-button" type="button" class="btn btn-primary" onclick="applyCheckpoints()">Apply saved rows</button>
    </div>
    <button id="complete-task-button" type="button" class="btn" onclick="completeTask()">Complete task</button>
  </footer>

  <script>
  window.PALETTE_KEYPOINT_SESSION_ID = @@session_id_json@@;
</script>
<script src="@@canvas_stage_fit_js@@"></script>
<script src="@@keypoint_style_js@@"></script>
<script>
@@operator_support_js@@
</script>
<script>
@@browser_mutation_status_js@@
</script>
<script>
@@image_canvas_viewport_js@@
</script>
<script>
@@keypoint_editor_js@@
</script>
<script>
  fitCanvasToStage(document.getElementById("canvas"), document.getElementById("canvas-stage"));
  // The marker overlay is drawn at screen resolution; redraw it when the
  // displayed canvas size changes.
  new ResizeObserver(() => draw()).observe(document.getElementById("canvas"));
</script>
</body>
</html>
