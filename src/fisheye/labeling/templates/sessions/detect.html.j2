<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@@safe_title@@</title>
  <link rel="stylesheet" href="@@palette_css@@">
  <link rel="stylesheet" href="@@editor_css@@">
  <style>
    :root { --bad: var(--danger); --muted: var(--ink-2); }
    @@session_operator_support_css@@
  </style>
</head>
<body class="editor">
  <header class="editor-top">
    <nav class="editor-return" aria-label="Return">@@return_links@@</nav>
    <div class="editor-title">
      <h1>@@safe_title@@</h1>
      <span>Scoped detection session <code>@@session_id@@</code></span>
    </div>
  </header>

  <div class="editor-body">
    <div id="canvas-stage" class="editor-stage">
      <div class="canvas-frame">
        <canvas id="canvas"></canvas>
        <canvas id="detect-overlay" class="canvas-overlay" aria-hidden="true"></canvas>
      </div>
      <div class="stage-hint">Drag empty space to add a box · click a box to select it · scroll to zoom</div>
    </div>

    <aside class="editor-side" aria-label="Detection tools">
      @@session_operator_support_html@@

      <section class="side-section" aria-labelledby="boxes-heading">
        <h2 id="boxes-heading">Boxes</h2>
        <button type="button" class="btn" data-key="T" onclick="placeTypicalBox()">Add typical box</button>
        <button type="button" class="btn" data-key="Delete" onclick="clearSelectedBox()">Remove selected box</button>
        <p class="meta">Drag empty image space to add a box. Click a box to select it; drag from the selected box to redraw it. Delete removes only the selected observation. Stable instance identities are assigned and checked by the server.</p>
      </section>

      <section class="side-section" aria-labelledby="frame-heading">
        <h2 id="frame-heading">This frame</h2>
        <div id="summary" class="meta"></div>
        <button type="button" class="btn btn-danger" data-key="X" onclick="markNegative()">Mark negative + next</button>
        <p class="meta">Use <b>Mark negative</b> only for an empty frame where the subject is outside the dish.</p>
      </section>

      <details class="side-section">
        <summary class="side-heading">Keyboard shortcuts</summary>
        <p class="meta">Wheel zooms, middle-drag pans, <kbd>F</kbd> fits, <kbd>T</kbd> adds a typical box, <kbd>Delete</kbd> removes selected, <kbd>S</kbd> saves, <kbd>X</kbd> marks an empty frame negative, <kbd>N</kbd>/<kbd>P</kbd> navigate.</p>
      </details>

      <details class="side-section">
        <summary class="side-heading">Session</summary>
        @@status_banner@@
      </details>
    </aside>
  </div>

  <footer class="editor-actions">
    <button type="button" class="btn" data-key="P" onclick="nav(-1)">‹ Prev</button>
    <button type="button" class="btn btn-outline" data-key="S" onclick="save(false)">Save</button>
    <button type="button" class="btn btn-primary" onclick="save(true)">Save + Next</button>
    <button type="button" class="btn" data-key="N" onclick="nav(1)">Next ›</button>
    <div class="status-area">
      <p id="status" class="status" role="status">Loading frame...</p>
      <button id="copy-mutation-support-reference" type="button" class="btn" hidden onclick="copyMutationSupportReference(this)">Copy support reference</button>
    </div>
    <button type="button" class="btn" onclick="completeTask()">Complete task</button>
  </footer>

  <script>
  window.PALETTE_DETECT_SESSION_ID = @@session_id_json@@;
</script>
<script src="@@canvas_stage_fit_js@@"></script>
<script>
@@operator_support_js@@
</script>
<script>
@@browser_mutation_status_js@@
</script>
<script>
@@image_canvas_viewport_js@@
</script>
<script>
@@detect_editor_js@@
</script>
<script>
  fitCanvasToStage(document.getElementById("canvas"), document.getElementById("canvas-stage"));
  // Boxes and labels draw at screen resolution; redraw when the size changes.
  new ResizeObserver(() => draw()).observe(document.getElementById("canvas"));
</script>
</body>
</html>
