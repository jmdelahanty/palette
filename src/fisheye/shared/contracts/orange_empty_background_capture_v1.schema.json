{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.empty_background_capture.v1",
  "title": "Orange empty-dish background capture descriptor (version 1 DRAFT)",
  "description": "DRAFT 2026-11-02 (design docs/empty_background_capture_design.md; layout agreed with Palette 2026-11-02). background.json in ~/orange_data/backgrounds/<capture_id>/, written last and atomically, and copied byte for byte to <recording>/empty_background/background.json when a recording attaches the capture. One per-pixel median of 17 consecutive frames per streaming camera, taken with empty dishes before the fish go in, under the recording's camera settings. Recording-specific status (attached, settings_changed, ...) is in the start snapshot (orange_recording_empty_background_v1), never here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "capture_id",
    "captured_at_utc",
    "scene_declaration",
    "method",
    "pixel_declaration",
    "cameras"
  ],
  "properties": {
    "schema_id": {
      "const": "orange.empty_background_capture"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "captured_at_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z(?![\\s\\S])"
    },
    "scene_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dishes_empty",
        "stimulus_display"
      ],
      "properties": {
        "dishes_empty": {
          "const": true
        },
        "note": {
          "type": "string",
          "maxLength": 4096
        },
        "stimulus_display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "state"
          ],
          "properties": {
            "source": {
              "const": "operator_declared",
              "description": "Orange cannot observe the display (Citrus/SpecSail drive it; no binding exists before a recording)."
            },
            "state": {
              "enum": [
                "off",
                "on",
                "unknown",
                "not_displayed"
              ],
              "description": "off: a display is in the light path and dark. not_displayed: no display in the light path. unknown: the operator does not know (Palette treats it like on with an unknown scene)."
            },
            "shown": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "solid_color",
                    "canvas",
                    "other"
                  ]
                },
                "rgba8": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "description": "Resolved sRGB colour, 8 bits per channel (rig colour standard; hex is only ever derived from it)."
                },
                "canvas_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "Citrus canvas name."
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "solid_color"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "rgba8"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "solid_color"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "canvas_name"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "solid_color"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "note"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "canvas"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "canvas_name"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "canvas"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "rgba8"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "canvas"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "note"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "other"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "note"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "other"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "rgba8"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "other"
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "canvas_name"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "on"
                  }
                }
              },
              "then": {
                "required": [
                  "shown"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "off",
                      "unknown",
                      "not_displayed"
                    ]
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "shown"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "frame_count"
      ],
      "properties": {
        "name": {
          "const": "median_17"
        },
        "version": {
          "type": "integer",
          "const": 1
        },
        "frame_count": {
          "type": "integer",
          "const": 17
        }
      }
    },
    "pixel_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "range",
        "conversion"
      ],
      "properties": {
        "encoding": {
          "const": "raw_sensor_mono8"
        },
        "range": {
          "const": "full"
        },
        "conversion": {
          "const": "none"
        }
      },
      "description": "The PNG holds the sensor's Mono8 values unchanged: full range 0-255, no tv-range shift, no gamma, no flat-field."
    },
    "registration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Present only when a dish registration was selected at capture; absence is normal."
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "camera_serial",
          "capture_status",
          "camera_configuration"
        ],
        "properties": {
          "camera_serial": {
            "type": "string",
            "pattern": "^[0-9]{1,20}(?![\\s\\S])",
            "description": "Exact camera serial (EVT serials are decimal digits). Unique within cameras[] (a consumer check; JSON Schema cannot express it)."
          },
          "capture_status": {
            "enum": [
              "captured",
              "failed"
            ]
          },
          "camera_configuration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "offset_x",
              "offset_y",
              "pixel_format",
              "frame_rate_hz",
              "exposure_us",
              "gain",
              "focus",
              "iris"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "offset_x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "offset_y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "pixel_format": {
                "const": "Mono8"
              },
              "frame_rate_hz": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "exposure_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "gain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "focus": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "iris": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            },
            "description": "Camera settings as configured at capture (Orange runtime configuration). All are unsigned integers at the source (Orange CameraParams: exposure in microseconds, gain and iris and focus in camera units, frame rate in Hz), so equality is exact. Every key except frame_rate_hz is checked at record start."
          },
          "source_frames": {
            "type": "array",
            "minItems": 17,
            "maxItems": 17,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stream_frame_id",
                "camera_frame_id",
                "camera_timestamp_ns",
                "timestamp_sys_ns"
              ],
              "properties": {
                "stream_frame_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615,
                  "description": "Orange's per-camera counter since stream open (frame_identity_v1). The burst is outside any recording, so there is no recording_frame_id."
                },
                "camera_frame_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "description": "The camera's own frame counter (agent-contracts citrus-orange/frame_identity_v1): 1..65535, wraps 65535 -> 1, never 0. Used only to show the 17 frames were consecutive."
                },
                "camera_timestamp_ns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615,
                  "description": "Camera PTP timestamp (TAI). Host CLOCK_REALTIME at exposure = this - 37 s (agent-contracts orange-palette/camera_exposure_host_clock_v1)."
                },
                "timestamp_sys_ns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615,
                  "description": "Host receive time; about 9.1 ms after exposure. Not for stimulus timing."
                }
              }
            },
            "description": "The 17 consecutive burst frames, in stream order."
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_path",
              "size_bytes",
              "sha256"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "pattern": "^Cam[0-9]{1,20}_empty_background\\.png(?![\\s\\S])",
                "description": "Cam<camera_serial>_empty_background.png; the serial equals this entry's camera_serial (a consumer check)."
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              }
            },
            "description": "PNG, 8-bit greyscale, no alpha, no gAMA/iCCP/sRGB chunks; IHDR width/height equal camera_configuration."
          },
          "statistics": {
            "$ref": "orange.image_levels.v1",
            "description": "Levels of the median image."
          },
          "any_frame_saturated_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "x-orange-decimals": 8,
            "description": "Fraction of pixels equal to 255 in at least one of the 17 burst frames. Marks where subtraction is unreliable; the median cannot show it."
          },
          "failure_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "captured"
                }
              }
            },
            "then": {
              "required": [
                "source_frames",
                "image",
                "statistics",
                "any_frame_saturated_fraction"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "captured"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "required": [
                "failure_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "image"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "statistics"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "capture_status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "any_frame_saturated_fraction"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
