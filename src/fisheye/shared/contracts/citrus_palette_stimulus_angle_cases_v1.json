  "legacy_to_v1": [
    {
      "name": "legacy 90 (down) is v1 -90",
      "legacy_deg": 90,
      "expect_v1_deg": -90
    },
    {
      "name": "legacy -31.8 (baker_baier_dots) is v1 31.8",
      "legacy_deg": -31.8,
      "expect_v1_deg": 31.8
    },
    {
      "name": "legacy 0 and 180 are unchanged",
      "legacy_deg": 180,
      "expect_v1_deg": -180
    },
    {
      "name": "legacy 270 (up) is v1 -270, i.e. 90",
      "legacy_deg": 270,
      "expect_v1_deg": 90
    }
  ],
  "moving_grating_drift": {
    "rule": "orientation era (file has orientation_degrees, no motion_direction_degrees): drift_legacy = orientation + 180 if speed_pps > 0, orientation if speed_pps < 0, undefined (static, no drift; consumers refuse a direction) if speed_pps == 0. motion era (file has motion_direction_degrees): drift_legacy = motion_direction_degrees for ANY non-zero speed sign (Citrus derives the render axis = motion + 180 for speed >= 0 and = motion for speed < 0, so the authored motion angle is always the drift); speed_pps == 0 is static. unit-circle era (citrus.stimulus_protocol schema_version 2): drift_v1 = motion_direction_degrees. All legacy drifts are clockwise (+90 = down); drift_v1 = -drift_legacy. Compare under wrap_delta.",
    "cases": [
      {
        "name": "a orientation era, orientation 90, speed +50",
        "era": "orientation",
        "orientation_degrees": 90,
        "speed_pps": 50,
        "expect_drift_legacy_deg": 270,
        "expect_drift_v1_deg": -270
      },
      {
        "name": "b orientation era, orientation 90, speed -50",
        "era": "orientation",
        "orientation_degrees": 90,
        "speed_pps": -50,
        "expect_drift_legacy_deg": 90,
        "expect_drift_v1_deg": -90
      },
      {
        "name": "c orientation era, Blindfish orientation 0, speed +62.54",
        "era": "orientation",
        "orientation_degrees": 0,
        "speed_pps": 62.54,
        "expect_drift_legacy_deg": 180,
        "expect_drift_v1_deg": -180
      },
      {
        "name": "c2 orientation era, speed 0 is static",
        "era": "orientation",
        "orientation_degrees": 45,
        "speed_pps": 0,
        "expect_drift_legacy_deg": null,
        "expect_drift_v1_deg": null
      },
      {
        "name": "d motion era, motion -90 STIMULUS_CANVAS, speed +50",
        "era": "motion",
        "motion_direction_degrees": -90,
        "speed_pps": 50,
        "expect_drift_legacy_deg": -90,
        "expect_drift_v1_deg": 90
      },
      {
        "name": "d2 motion era, motion -90, speed -50 (sign does not flip the drift)",
        "era": "motion",
        "motion_direction_degrees": -90,
        "speed_pps": -50,
        "expect_drift_legacy_deg": -90,
        "expect_drift_v1_deg": 90
      },
      {
        "name": "e unit-circle era, motion 90 is up",
        "era": "unit_circle",
        "motion_direction_degrees": 90,
        "speed_pps": 50,
        "expect_drift_v1_deg": 90,
        "expect_vector": [
          0.0,
          -1.0
        ]
      },
      {
        "name": "f legacy->v1 of a: 270 -> -270 (same direction as 90, up)",
        "era": "orientation",
        "orientation_degrees": 90,
        "speed_pps": 50,
        "expect_drift_legacy_deg": 270,
        "expect_drift_v1_deg": 90
      }
    ]
  }
}
