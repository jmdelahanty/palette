      "expect_det_sign": -1
    },
    {
      "name": "preserved rig rotated 30 degrees counter-clockwise camera->canvas: canvas up is camera 60",
      "rig": "preserved",
      "H_camera_to_canvas": [
        [
          1.7320508075688774,
