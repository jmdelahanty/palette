{
  "description": "Reference cases for stimulus_angle_convention_v1 (id atan2_negative_y_x_degrees) in y-down rasters. angle -> vector (cos t, -sin t); vector -> degrees(atan2(-y, x)); angles compared with wrap_delta(d) = ((d + 180) mod 360) - 180 (floored mod) under tolerance_deg. Cross-raster cases give the camera->canvas homography H; canvas_to_camera maps through the Jacobian of inverse(H) at a canvas point, camera_to_canvas through the Jacobian of H at a camera point. Expected cross-raster angles were computed independently by finite differences through the full projective map.",
  "tolerance_deg": 1e-05,
  "tolerance_vector": 1e-12,
  "angle_to_vector": [
    {
      "name": "0 is right",
      "angle_deg": 0,
      "expect_vector": [
        1.0,
        0.0
      ]
    },
    {
      "name": "45 is up-right",
      "angle_deg": 45,
      "expect_vector": [
        0.7071067811865476,
        -0.7071067811865476
      ]
    },
    {
      "name": "90 is up (y negative)",
      "angle_deg": 90,
      "expect_vector": [
        0.0,
        -1.0
      ]
    },
    {
      "name": "180 is left",
      "angle_deg": 180,
      "expect_vector": [
        -1.0,
        0.0
      ]
    },
    {
      "name": "-90 is down (y positive)",
      "angle_deg": -90,
      "expect_vector": [
        0.0,
        1.0
      ]
    },
    {
      "name": "270 is down, not normalised",
      "angle_deg": 270,
      "expect_vector": [
        0.0,
        1.0
      ]
    },
    {
      "name": "-180 is left",
      "angle_deg": -180,
      "expect_vector": [
        -1.0,
        0.0
      ]
    },
    {
      "name": "450 is up, not normalised",
      "angle_deg": 450,
      "expect_vector": [
        0.0,
        -1.0
      ]
    }
  ],
  "vector_to_angle": [
    {
      "name": "right",
      "vector": [
        1.0,
        0.0
      ],
      "expect_angle_deg": 0.0
    },
    {
      "name": "up-right",
      "vector": [
        3.0,
        -3.0
      ],
      "expect_angle_deg": 45.0
    },
    {
      "name": "up",
      "vector": [
        0.0,
        -2.0
      ],
      "expect_angle_deg": 90.0
    },
    {
      "name": "down",
      "vector": [
        0.0,
        5.0
      ],
      "expect_angle_deg": -90.0
    },
    {
      "name": "left with y = 0 gives -180 in IEEE (same as +180)",
      "vector": [
        -1.0,
        0.0
      ],
      "expect_angle_deg": -180.0,
      "also_accept_deg": 180.0
    },
    {
      "name": "down-left",
      "vector": [
        -1.0,
        1.0
      ],
      "expect_angle_deg": -135.0
    }
  ],
  "wrap_delta": [
    {
      "d": 0,
      "expect": 0
    },
    {
      "d": 190,
      "expect": -170
    },
    {
      "d": -190,
      "expect": 170
    },
    {
      "d": 180,
      "expect": -180,
      "note": "+180 and -180 are the same direction; wrap_delta maps both to -180"
    },
    {
      "d": -180,
      "expect": -180
    },
    {
      "d": 359,
      "expect": -1
    },
    {
      "d": 360,
      "expect": 0
    },
    {
      "d": 540,
      "expect": -180
    },
    {
      "d": -270,
      "expect": 90
    }
  ],
  "same_direction": [
    {
      "name": "-180 and 180 identity",
      "a": -180,
      "b": 180
    },
    {
      "name": "270 and -90",
      "a": 270,
      "b": -90
    },
    {
      "name": "450 and 90",
      "a": 450,
      "b": 90
    }
  ],
  "cross_raster": [
