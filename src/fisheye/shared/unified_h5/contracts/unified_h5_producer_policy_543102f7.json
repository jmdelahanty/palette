      "contract_id": "stimulus_angle_convention",
      "version": 1,
      "path": "citrus-palette/angles/stimulus_angle_convention_v1.json",
      "rule": "the convention of every stimulus direction angle in a file is fixed by the admitted catalog binding the file selects (core_definition_pins.<catalog>.stimulus_angle_convention), never by a file attribute alone: angle_v1 and later catalogs -> atan2_negative_y_x_degrees; historical_v1, chaser_v2, bounding_boxes_v2 and frame_identity_v1 -> canvas_y_down_clockwise_legacy; a file whose binding selects angle_v1 but whose /metadata/session attribute stimulus_angle_convention is absent or differs from atan2_negative_y_x_degrees is refused with stimulus_angle_convention_mismatch (as catalog_id_mismatch); the attribute is not read for legacy bindings",
      "h5_declaration": "/metadata/session attribute stimulus_angle_convention"
    },
