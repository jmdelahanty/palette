    "selection": {
      "key": "table_version_map",
      "rule": "the file's map {core table path -> dataset schema_version attribute}, over every table of an admitted catalog that the capacity preflight declares, must equal that catalog's table_version_map; a declared table whose version is not in any admitted map is refused; absent and undeclared tables do not constrain the choice (as revision 3); the map together with the declared capacity_preflight_json.catalog_id (preflight v2, v3, v4 or v5) must select exactly one admitted catalog: catalog_id must name a catalog whose map the file matches, otherwise the file is refused with catalog_id_mismatch rather than no_binding; a file that declares none of /components/moving_grating/states, /components/independent_motion_grid/states, /components/phototaxis/states and /components/video_tracking_overlay/states matches frame_identity_v1, angle_v1, phototaxis_v1 and video_overlay_v1 by map and is told apart only by catalog_id (and the binding's admission_policy_sha256); every table attribute is validated against the selected catalog, and the selected catalog fixes the stimulus angle convention (versions.stimulus_angle)",
      "legacy_pair_key": [
        "chaser_state",
        "bounding_boxes"
      ],
      "legacy_pair_rule": "revision 2 and 3 catalogs (historical_v1, chaser_v2, bounding_boxes_v2) remain selectable by their (chaser_state, bounding_boxes) pair for files without catalog_id (preflight v1); pair keys are unique only over these three legacy catalogs; the map-keyed catalogs (frame_identity_v1, angle_v1, phototaxis_v1, video_overlay_v1) share the pair (3, 3) and are distinguished by table_version_map plus catalog_id, never by the pair",
      "current_producer_catalog": "video_overlay_v1"
