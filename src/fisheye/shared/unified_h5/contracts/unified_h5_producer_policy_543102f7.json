      "schema_id": "citrus.experimental_h5.phototaxis_state",
      "schema_version": 1
    },
    "reactive_phototaxis": {
      "contract_id": "reactive_phototaxis",
      "version": 1,
      "path": "citrus-palette/reactive_phototaxis/reactive_phototaxis_states_v1.json",
      "rule": "a trial index with a mode-18 step whose features.fill.type is heading_split (features.reactive present exactly then) is admitted only under the phototaxis_v1 binding and only when /components/phototaxis/states is present and declared; revisions 1 to 5 refuse such a file; features.fill.style gradient and features.reactive.fill_style gradient are reserved and refused by this revision; the per-row invariants are those of the states contract, with validity flags (heading_valid, midline_valid, held_valid, *_valid) instead of NaN payloads",
      "h5_declaration": "/components/phototaxis/states attribute schema_version 1; trial index features.reactive"
    },
    "video_overlay_state": {
      "schema_id": "citrus.experimental_h5.video_overlay_state",
      "schema_version": 1
    },
    "video_tracking_overlay": {
      "contract_id": "video_tracking_overlay",
      "version": 1,
      "path": "citrus-palette/video_tracking_overlay/video_tracking_overlay_states_v1.json",
      "rule": "a file that declares the video_tracking_overlay component (video logging on and the overlay enabled) is admitted only under the video_overlay_v1 binding and only with /components/video_tracking_overlay/states (schema_version 1) and /components/video_tracking_overlay/settings_json present; one states row per /frames/stimulus row; revisions 1 to 6 refuse such a file; the per-row invariants, the bounding-box and pose cross-checks and the exact position, arrow origin and direction arithmetic are those of the states contract (typed validity flags, payload zero, no NaN)",
      "h5_declaration": "/components/video_tracking_overlay/states attribute schema_version 1; /components/video_tracking_overlay/settings_json schema_id citrus.video_tracking_overlay schema_version 1"
    }
