    "rule": "the H5's /metadata/admission/capacity_preflight_json admission_policy_sha256 (lowercase hex, no prefix) must equal the producer_policy file_sha256 bound to the catalog that the file's table-version map selects (core_definition_pins.selection), and that preflight JSON must validate against the same binding's capacity_preflight_schema; for preflight v2 the declared catalog_id must name that same binding; a policy digest, schema, catalog or catalog_id from different bindings is refused",
    "declared_tables": {
      "declared_by": "/metadata/admission/capacity_preflight_json tables[].path",
      "rule": "the protocol declares the core table set: Citrus derives it from the protocol steps (src/logging/experimental_h5_selected_catalog.h SelectedCoreComponents) and seals it, with the correspondence and pose tables, in the capacity preflight that every bound recording carries; for the tables of the selected core catalog, a declared table that is absent, or a present core table that is not declared, is refused; a selection-key table that is not declared (chaser_state in every non-chaser protocol, the 2026-10-09 sessions included) does not constrain the choice; the declared tables' schema_versions (the table-version map; the (chaser_state, bounding_boxes) pair for revision 2 and 3 catalogs) together with the declared admission_policy_sha256 and, for preflight v2, catalog_id must select exactly one admitted binding, otherwise the file is refused; (chaser undeclared, bounding_boxes 1) with d544b081 selects chaser_v2, (chaser undeclared, bounding_boxes 2) with b2af7764 selects bounding_boxes_v2; this clause lives here rather than in core_definition_pins.selection so the frozen producer policy is unchanged; frame_identity_v1 is selected only by its full map plus catalog_id frame_identity_v1 and policy 3c9866ed",
      "non_core_declared_tables": {
        "/correspondence/frames/sources": "always present when declared (core catalog table)",
        "/correspondence/acquisition/live_frame_identities": "correspondence_definition_pins; present when declared",
        "/correspondence/acquisition/live_chaser_identities": "correspondence_definition_pins; present when declared (may be empty)",
        "/correspondence/chaser/sources": "declared by the preflight in every protocol but conditional_on_chaser_rows (correspondence_scope.chaser_sources_presence): absent in every non-chaser recording, the 2026-10-09 sessions included; its absence is not a refusal when chaser_state is undeclared",
        "/observations/pose/*": "governed by citrus-pose-observation-v1 or citrus-pose-observation-v2 according to contract_json.schema_version: present iff pose_observations is declared in component_outcomes"
      }
    },
