        {
          "name": "recording_frame_id",
          "dtype": "<u8",
          "offset": 8,
          "count": 1,
          "units": "1",
          "meaning": "Orange one-based recording-wide frame ID; zero is missing current identity and prevents complete correspondence. Not the stream-local SHAMAN state frame ID or a clip-local index.",
          "validity_field": "",
          "boolean": false
        }
      ],
      "required_reference_attributes": [],
      "required_attributes": {
        "schema_id": {
          "dtype": "utf8",
          "value": "citrus.experimental_h5.live_frame_identity.v2"
        },
        "schema_version": {
          "dtype": "<u8",
          "value": 2
        },
        "ordering": {
          "dtype": "utf8",
          "value": "append_order_v2"
        }
      },
      "digest_encoding": "hdf5_closed_logical_values_v1",
      "validation": {
        "order": "strictly_increasing_stimulus_frame_num_v2",
