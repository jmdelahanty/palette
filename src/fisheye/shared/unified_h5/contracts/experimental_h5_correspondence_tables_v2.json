    },
    {
      "id": "citrus.experimental_h5.live_chaser_identity.v2",
      "schema_version": 2,
      "path": "/correspondence/acquisition/live_chaser_identities",
      "component": "correspondence_input",
      "rank": 1,
      "row_order": "append_order_v2",
      "key_fields": "stimulus_frame_num,chaser_index",
      "itemsize": 33,
      "fields": [
        {
          "name": "chaser_index",
          "dtype": "<i8",
          "offset": 0,
          "count": 1,
          "units": "1",
          "meaning": "Citrus chaser instance index; zero valid. Signed raw capture preserves negative malformed evidence; complete correspondence requires nonnegative values and equality to the canonical chaser row.",
          "validity_field": "",
          "boolean": false
        },
        {
          "name": "stimulus_frame_num",
          "dtype": "<u8",
          "offset": 8,
          "count": 1,
          "units": "1",
          "meaning": "Citrus session stimulus frame key; zero valid; exactly matches the canonical chaser row's frame key.",
          "validity_field": "",
          "boolean": false
        },
        {
          "name": "source_recording_frame_id",
          "dtype": "<u8",
          "offset": 16,
          "count": 1,
          "units": "1",
          "meaning": "Orange one-based recording-wide current-source frame ID; must equal the live frame identity for this stimulus frame. Zero is invalid for complete correspondence.",
          "validity_field": "",
          "boolean": false
        },
        {
          "name": "target_recording_frame_valid",
          "dtype": "|u1",
          "offset": 24,
          "count": 1,
          "units": "1",
          "meaning": "Explicit held-target recording identity validity: 0 absent, 1 present. Invalid payload must be zero.",
          "validity_field": "",
          "boolean": true
        },
        {
          "name": "target_recording_frame_id",
          "dtype": "<u8",
          "offset": 25,
          "count": 1,
          "units": "1",
          "meaning": "Orange one-based recording-wide held-target frame ID, distinct from the current source; may be older. When valid=0 the payload must be zero; when valid=1 it must be in [1, total_acquisitions].",
          "validity_field": "target_recording_frame_valid",
          "boolean": false
        }
      ],
      "required_reference_attributes": [],
      "required_attributes": {
        "schema_id": {
          "dtype": "utf8",
          "value": "citrus.experimental_h5.live_chaser_identity.v2"
