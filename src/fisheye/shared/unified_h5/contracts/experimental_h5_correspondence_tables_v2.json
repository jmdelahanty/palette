          "dtype": "<u8",
          "value": 2
        },
        "ordering": {
          "dtype": "utf8",
          "value": "append_order_v2"
        }
      },
      "digest_encoding": "hdf5_closed_logical_values_v1",
      "validation": {
        "order": "nondecreasing_frame_unique_chaser_per_frame_canonical_row_ordinal_v2",
        "unique_key_fields": [
          "stimulus_frame_num",
          "chaser_index"
        ],
        "canonical_table_ref": "/components/chaser/states",
        "canonical_row_ordinal_match": true,
        "within_frame_chaser_index_sort_required": false,
        "maximum_chasers_per_frame": 4096,
        "chaser_index_minimum": 0,
        "current_source_frame_table_ref": "/correspondence/acquisition/live_frame_identities",
        "invalid_payload_values": {
          "target_recording_frame_id": 0
        },
        "boolean_values": [
          0,
          1
        ],
        "target_recording_frame_id_valid_minimum": 1,
        "target_recording_frame_id_valid_maximum_ref": "/correspondence/receipt_json#/mapping_validation/total_acquisitions",
        "held_target_before_current_required": false
      }
    }
  ],
