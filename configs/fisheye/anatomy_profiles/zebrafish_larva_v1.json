  "digest_algorithm": "sha256_canonical_json_v1",
  "description": "Shared modality-neutral anatomy roles and recipes for zebrafish larvae.",
  "roles": [
    {
      "role_id": "swim_bladder",
      "description": "Semantic center of the swim bladder landmark or component."
    },
    {
      "role_id": "eye_left",
      "description": "Semantic center of the larva's left eye."
    },
    {
      "role_id": "eye_right",
      "description": "Semantic center of the larva's right eye."
    },
    {
      "role_id": "subject_body",
      "description": "Projected whole-subject body component."
    }
  ],
  "recipes": [
    {
      "recipe_id": "head_triad_equal_mean",
      "kind": "point",
      "required_roles": ["swim_bladder", "eye_left", "eye_right"],
      "expression": {
        "op": "mean_points",
        "weighting": "equal_per_point",
        "points": [
          {"op": "role_point", "role_id": "swim_bladder"},
          {"op": "role_point", "role_id": "eye_left"},
          {"op": "role_point", "role_id": "eye_right"}
        ]
      },
      "description": "Equal mean of swim bladder and both eye centers."
    },
    {
      "recipe_id": "eye_pair_midpoint",
      "kind": "point",
      "required_roles": ["eye_left", "eye_right"],
      "expression": {
        "op": "midpoint",
        "points": [
          {"op": "role_point", "role_id": "eye_left"},
          {"op": "role_point", "role_id": "eye_right"}
        ]
      },
      "description": "Midpoint of the two independently labeled eye centers."
    },
    {
      "recipe_id": "subject_body_centroid",
      "kind": "point",
      "required_roles": ["subject_body"],
      "expression": {
        "op": "role_point",
        "role_id": "subject_body"
      },
      "description": "Centroid of the projected whole-subject body component."
    },
    {
      "recipe_id": "anterior_axis",
      "kind": "axis",
      "required_roles": ["swim_bladder", "eye_left", "eye_right"],
      "expression": {
        "op": "axis",
        "from": {"op": "role_point", "role_id": "swim_bladder"},
        "to": {
          "op": "midpoint",
          "points": [
            {"op": "role_point", "role_id": "eye_left"},
            {"op": "role_point", "role_id": "eye_right"}
          ]
        }
      },
      "description": "Forward axis from swim bladder toward the eye-pair midpoint."
    }
  ],
